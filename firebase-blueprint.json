{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense record belonging to a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Whether this record is income or expense"
        },
        "amount": {
          "type": "number",
          "description": "Positive monetary amount in THB"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category name for this record"
        },
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Short description or title of transaction"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of transaction in YYYY-MM-DD"
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional additional note or details"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "transfer", "credit_card", "other"],
          "description": "Payment channel used"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "type", "amount", "category", "title", "date", "createdAt", "updatedAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly category budget limit set by user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "description": "Target month in YYYY-MM"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category name or 'all'"
        },
        "targetAmount": {
          "type": "number",
          "description": "Target max expense budget in THB"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "month", "category", "targetAmount", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "currency": {
          "type": "string",
          "maxLength": 10,
          "description": "Currency symbol or code (e.g. THB)"
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Overall monthly expense budget"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Collection of all financial transaction entries"
    },
    "/budgets/{budgetId}": {
      "schema": {
        "$ref": "#/entities/Budget"
      },
      "description": "Monthly budgets set by users"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile and financial preferences"
    }
  }
}
