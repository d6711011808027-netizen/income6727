rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Transaction
    function isValidTransaction(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.type in ['income', 'expense'] &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 100000000 &&
             data.category is string &&
             data.category.size() > 0 &&
             data.category.size() <= 50 &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 100 &&
             data.date is string &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
             (!('paymentMethod' in data) || (data.paymentMethod in ['cash', 'transfer', 'credit_card', 'other'])) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation for Budget
    function isValidBudget(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.month is string &&
             data.month.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.category is string &&
             data.category.size() > 0 &&
             data.category.size() <= 50 &&
             data.targetAmount is number &&
             data.targetAmount > 0 &&
             data.targetAmount <= 100000000 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('monthlyBudget' in data) || (data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 100000000)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(transactionId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(transactionId) &&
                       incoming().keys().hasAll(['userId', 'type', 'amount', 'category', 'title', 'date', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'type', 'amount', 'category', 'title', 'date', 'note', 'paymentMethod', 'createdAt', 'updatedAt']) &&
                       isValidTransaction(incoming());
      allow update: if isSignedIn() &&
                       isValidId(transactionId) &&
                       existing().userId == request.auth.uid &&
                       isValidTransaction(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'title', 'date', 'note', 'paymentMethod', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(transactionId) && existing().userId == request.auth.uid;
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(budgetId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(budgetId) &&
                       incoming().keys().hasAll(['userId', 'month', 'category', 'targetAmount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'month', 'category', 'targetAmount', 'createdAt', 'updatedAt']) &&
                       isValidBudget(incoming());
      allow update: if isSignedIn() &&
                       isValidId(budgetId) &&
                       existing().userId == request.auth.uid &&
                       isValidBudget(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['month', 'category', 'targetAmount', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(budgetId) && existing().userId == request.auth.uid;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'currency', 'monthlyBudget', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currency', 'monthlyBudget', 'updatedAt']);
      allow delete: if false; // Profiles are preserved
    }

    // Connection testing
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
